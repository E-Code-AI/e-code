# E-Code Mobile Environment Configuration
# Copy this file to .env for local development

# The environment name (development|staging|production)
EXPO_PUBLIC_ENV=development

# The base URL for the API
# For local Replit development, use your workspace URL with /api suffix
# For production, use https://e-code.ai/api
EXPO_PUBLIC_API_BASE=http://localhost:5000/api

# Optional: Release channel for EAS updates
EXPO_PUBLIC_RELEASE_CHANNEL=default
