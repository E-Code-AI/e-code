# ═══════════════════════════════════════════════════════════════
# E-Code Platform - NPM Configuration
# Optimized for Replit Reserved VM deployment
# Domain: https://e-code.ai
# Verified: 26 November 2025 ✅
# ═══════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────
# REPLIT OPTIMIZATION
# ─────────────────────────────────────────────────────────────────

# Disable package-lock.json (reduces deployment size on Replit)
# Note: Replit manages dependencies differently, lock file not needed
package-lock=false

# Skip optional dependencies to reduce installation size
optional=false

# Cache location optimized for Replit's ephemeral storage
cache=/tmp/npm-cache

# ─────────────────────────────────────────────────────────────────
# DEPENDENCY MANAGEMENT
# ─────────────────────────────────────────────────────────────────

# Use legacy peer deps to avoid React/Node.js conflicts
# Required for many packages that haven't updated peer deps
legacy-peer-deps=true

# Don't install dev dependencies in production builds
production=false

# ─────────────────────────────────────────────────────────────────
# PERFORMANCE & NETWORK
# ─────────────────────────────────────────────────────────────────

# Reduce network retries for faster failure detection
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Show progress indicator during install
progress=true

# ─────────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────────

# Enforce strict SSL verification
strict-ssl=true

# Security audit level (moderate = skip low severity)
audit-level=moderate

# ─────────────────────────────────────────────────────────────────
# NOISE REDUCTION
# ─────────────────────────────────────────────────────────────────

# Disable npm fund messages
fund=false

# Disable update notifier
update-notifier=false
