# =============================================================================
# .replitignore - Exclude from Replit deployments
# =============================================================================

# Large user data directories (1.6GB+)
projects/
uploads/
backups/

# Dependencies (installed at deploy time)
node_modules/
.npm/
.pnpm-store/

# Source maps and type declarations (not needed in prod)
*.map
*.d.ts

# Development dependencies
scripts/
test/
*.test.*
*.spec.*

# Git repository
.git/

# Documentation
docs/
*.md

# Tests
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
coverage/
playwright-report/
test-results/

# IDE
.vscode/
.idea/

# Assets not needed
attached_assets/
previews/
screenshots/

# Logs
logs/
*.log

# Temporary
tmp/
temp/

# Mobile/Desktop
mobile/
desktop/
electron/
android/
ios/

# Kubernetes
kubernetes/
k8s/

# Docker
Dockerfile*
docker-compose*

# Replit dev files
.breakpoints
.upm/
.cache/

# Memory bank
.ecode/

# Replit agent session state (1GB+ of subagent cache - NOT needed for deployment)
.local/state/
.local/

# Checkpoints (not needed for deployment)
.checkpoints/
