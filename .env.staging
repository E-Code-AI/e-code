# Staging Environment Configuration
NODE_ENV=staging
PORT=5000

# Database Configuration - Staging
DATABASE_URL=postgres://localhost:5432/ecode_staging
DATABASE_POOL_MAX=10
DATABASE_POOL_MIN=2

# API URLs
API_URL=https://staging-api.e-code.ai
APP_URL=https://staging.e-code.ai

# SendGrid Configuration
SENDGRID_API_KEY=your-sendgrid-api-key-here
FROM_EMAIL=noreply@staging.e-code.ai
FROM_NAME=E-Code Platform (Staging)

# Monitoring
LOG_LEVEL=debug
ENABLE_MONITORING=true
ENABLE_PERFORMANCE_TRACKING=true

# Security
JWT_SECRET=your-staging-jwt-secret
SESSION_SECRET=your-staging-session-secret

# AI Services (Staging Keys)
OPENAI_API_KEY=your-staging-openai-key
ANTHROPIC_API_KEY=your-staging-anthropic-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Feature Flags
ENABLE_DEBUG_MODE=true
ENABLE_STAGING_FEATURES=true
ENABLE_EMAIL_NOTIFICATIONS=true

# Health Check
HEALTH_CHECK_INTERVAL_MS=30000
HEALTH_CHECK_TIMEOUT_MS=5000