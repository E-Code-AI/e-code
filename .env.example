NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ecode_dev
SESSION_SECRET=dev-session-secret-change-me-abcdef0123456789
JWT_SECRET=dev-jwt-secret-change-me-abcdef0123456789
JWT_REFRESH_SECRET=dev-jwt-refresh-secret-change-me-abcdef
ENCRYPTION_KEY=dev-encryption-key-32-bytes-aaaaa
REDIS_PASSWORD=dev-redis-pass
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REDIS_ENABLED=true
OPENAI_API_KEY=sk-placeholder-local-dev-0000000000000000000000
ANTHROPIC_API_KEY=sk-ant-placeholder-local-dev-00000000000
GOOGLE_AI_API_KEY=placeholder-dev
XAI_API_KEY=placeholder-dev
GROQ_API_KEY=placeholder-dev
STRIPE_SECRET_KEY=sk_test_placeholder_00000000000000000000000000
STRIPE_WEBHOOK_SECRET=whsec_placeholder_00000000000000000000
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_000000000000000000
SENTRY_DSN=
VITE_SENTRY_DSN=
SENDGRID_API_KEY=SG.placeholder_000000000000000000000000000
FROM_EMAIL=dev@localhost.test
ENABLE_COLLABORATION=true
ENABLE_AI=true
ENABLE_DEPLOYMENTS=true
ENABLE_BILLING=false
ENABLE_ANALYTICS=true
LOG_LEVEL=info
DISABLE_CSRF=true
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,http://localhost:5173
REPLIT_DOMAINS=*.repl.co,*.replit.dev,*.replit.app
NODE_OPTIONS=--max-old-space-size=4096
