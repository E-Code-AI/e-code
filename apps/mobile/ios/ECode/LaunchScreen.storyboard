<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" colorMatched="YES">
  <scenes>
    <scene sceneID="launch">
      <objects>
        <viewController id="vc" sceneMemberID="viewController">
          <view key="view" contentMode="scaleToFill" id="view">
            <rect key="frame" x="0" y="0" width="390" height="844"/>
            <subviews>
              <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="E-code" textAlignment="center" lineBreakMode="tailTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                <fontDescription key="fontDescription" type="boldSystem" pointSize="36"/>
                <color key="textColor" red="0.05" green="0.08" blue="0.12" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
              </label>
            </subviews>
            <color key="backgroundColor" red="0.96" green="0.98" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
            <constraints>
              <constraint firstItem="title" firstAttribute="centerX" secondItem="view" secondAttribute="centerX" id="cx"/>
              <constraint firstItem="title" firstAttribute="centerY" secondItem="view" secondAttribute="centerY" id="cy"/>
            </constraints>
          </view>
        </viewController>
        <placeholder placeholderIdentifier="IBFirstResponder" id="firstResponder" sceneMemberID="firstResponder"/>
      </objects>
    </scene>
  </scenes>
</document>
