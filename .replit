modules = ["web", "postgresql-16", "nodejs-22"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "jq", "libxcrypt", "imagemagick"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", ". /etc/profile 2>/dev/null; . ~/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; RUNNER_PORT=8081 node dist/runner.js & RUNNER_BASE_URL=http://localhost:8081 node --max-old-space-size=4096 dist/index.js"]
build = ["sh", "-c", "echo 'No build needed - dist/ is pre-built and committed'"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Runner"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_OPTIONS='--max-old-space-size=4096' npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Runner"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "RUNNER_PORT=8081 DOCKER_ENABLED=false RUNNER_JWT_SECRET=${RUNNER_JWT_SECRET:-dev-runner-secret-change-me} npx tsx runner/index.ts"

[agent]
integrations = [
  "javascript_slack:1.0.0",
  "javascript_openai:1.0.0",
  "javascript_anthropic:1.0.0",
  "javascript_xai:1.0.0",
  "javascript_gemini:1.0.0",
  "perplexity_v0:1.0.0",
  "javascript_sendgrid:1.0.0",
  "javascript_stripe:1.0.0",
  "javascript_websocket:1.0.0",
  "javascript_openai_ai_integrations:1.0.0",
]

[objectStorage]
defaultBucketID = "replit-objstore-2566672f-a4a2-4a4f-94f0-4e6c88fa4e9b"

[userenv]

[userenv.shared]
VITE_STRIPE_PUBLIC_KEY = "pk_live_51QPg0B2VSIgdqPLPDbmZ9Sr7cs6mB7sJjvIICcdzKbt88GGB901LRxH6RJtiNp0wMDQt0tm4LOS6zOEvKSP7g7Nv00NZTMdDKH"
REDIS_ENABLED = "true"
FEATURE_AI_UX_IMPROVE_PROMPT = "true"
FEATURE_AI_UX_EXTENDED_THINKING = "true"
FEATURE_AI_UX_HIGH_POWER_MODE = "true"
FEATURE_AI_UX_PROGRESS_TAB = "true"
FEATURE_AI_UX_PAUSE_RESUME = "true"
REPLIT_DEV_URL = "https://f4d2485e-81a7-4595-9868-17903ab251f3-00-ngx9sxwfcs19.riker.replit.dev:5000"
DISABLE_CSRF = "false"
FROM_EMAIL = "contact@e-code.ai"
WORKSPACE_TOKEN_TTL_MIN = "15"
RUNNER_BASE_URL = "http://localhost:8081"
STRIPE_WEBHOOK_SECRET = "whsec_drSl9KUZtP5tlyUKevilphko1lj8NNFe"

[userenv.development]
ALLOW_INSECURE_LOCAL_PTY = "true"

[userenv.production]
NODE_ENV = "production"
ALLOW_INSECURE_LOCAL_PTY = "false"
NODE_OPTIONS = "--max-old-space-size=4096"
LOG_LEVEL = "warn"
ENABLE_BILLING = "true"
ENABLE_COLLABORATION = "true"
ENABLE_AI = "true"
ENABLE_DEPLOYMENTS = "true"
ENABLE_ANALYTICS = "true"
PORT = "80"
DB_POOL_SIZE = "25"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5001
externalPort = 3002

[[ports]]
localPort = 5173
externalPort = 5173

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 24678
externalPort = 3000

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

