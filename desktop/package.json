{
  "name": "e-code-desktop",
  "version": "1.0.0",
  "description": "E-Code Desktop Application - Fortune 500 Quality AI-Powered IDE",
  "main": "main.js",
  "author": {
    "name": "E-Code Team",
    "email": "team@e-code.dev"
  },
  "homepage": "https://e-code.dev",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "DEV_SERVER_URL=http://localhost:5000 electron . --dev",
    "build": "electron-builder",
    "build:mac": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder -mwl",
    "pack": "electron-builder --dir",
    "postinstall": "electron-builder install-app-deps",
    "clean": "rimraf dist renderer",
    "prepare-renderer": "node scripts/prepare-renderer.js"
  },
  "build": {
    "appId": "com.ecode.desktop",
    "productName": "E-Code",
    "copyright": "Copyright © 2025 E-Code Team",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "!renderer/**/*.map"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "asar": true,
    "asarUnpack": [
      "renderer/**/*"
    ],
    "compression": "maximum",
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "resources/icon.icns",
      "darkModeSupport": true,
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.plist",
      "notarize": false,
      "minimumSystemVersion": "10.15"
    },
    "dmg": {
      "sign": false,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "resources/icon.ico",
      "publisherName": "E-Code",
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "E-Code",
      "menuCategory": "Development",
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico",
      "installerHeader": "resources/installer-header.bmp",
      "installerSidebar": "resources/installer-sidebar.bmp",
      "license": "resources/license.txt"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "rpm",
        "tar.gz"
      ],
      "icon": "resources/icons",
      "category": "Development",
      "maintainer": "E-Code Team <team@e-code.dev>",
      "vendor": "E-Code",
      "synopsis": "AI-Powered Development Platform",
      "description": "E-Code is a Fortune 500-grade AI-powered development platform for building and deploying applications.",
      "desktop": {
        "StartupNotify": "true",
        "StartupWMClass": "e-code-desktop"
      },
      "mimeTypes": [
        "text/plain",
        "text/javascript",
        "text/typescript",
        "text/html",
        "text/css",
        "application/json",
        "application/x-python-code"
      ]
    },
    "appImage": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "category": "Development"
    },
    "deb": {
      "priority": "optional",
      "compression": "xz",
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libuuid1",
        "libsecret-1-0"
      ]
    },
    "rpm": {
      "compression": "xz",
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "uuid",
        "libsecret"
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "e-code",
        "repo": "e-code-desktop",
        "releaseType": "release"
      }
    ],
    "electronDownload": {
      "cache": ".cache/electron"
    }
  },
  "keywords": [
    "electron",
    "code-editor",
    "ide",
    "developer-tools",
    "ai",
    "replit-clone",
    "vscode-alternative"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/e-code/e-code-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/e-code/e-code-desktop/issues"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "rimraf": "^6.0.1"
  }
}
