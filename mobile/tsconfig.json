{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "jsx": "react-jsx",
    "allowJs": false,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "types": ["jest", "node"],
    "baseUrl": "./",
    "paths": {
      "@screens/*": ["src/screens/*"],
      "@services/*": ["src/services/*"],
      "@types": ["src/types"],
      "@navigation/*": ["src/navigation/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src", "__mocks__", "../shared/mobile-types.ts"],
  "exclude": ["node_modules"]
}
