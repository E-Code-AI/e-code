import { useState, useEffect, useRef, useCallback } from 'react';
import { useParams, useLocation } from 'wouter';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import { useAuth } from '@/hooks/use-auth';
import { useToast } from '@/hooks/use-toast';
import { apiRequest } from '@/lib/queryClient';
import { File, Project } from '@shared/schema';
import { 
  ResizableHandle, 
  ResizablePanel, 
  ResizablePanelGroup 
} from '@/components/ui/resizable';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { Button } from '@/components/ui/button';
import { 
  Brain, 
  Zap, 
  Eye, 
  FileCode, 
  Terminal as TerminalIcon,
  GitBranch,
  Database,
  Lock,
  Globe,
  Puzzle,
  Search,
  Play,
  Shield,
  Users,
  Workflow,
  HardDrive,
  Settings,
  Code,
  TestTube,
  Server,
  Command,
  FileText,
  Loader2
} from 'lucide-react';
import { ECodeLoading } from '@/components/ECodeLoading';

// Use existing components directly
import { TopNavBar } from '@/components/ide/TopNavBar';
import { StatusBar } from '@/components/ide/StatusBar';
import { QuickFileSearch } from '@/components/ide/QuickFileSearch';
import { KeyboardShortcutsOverlay } from '@/components/ide/KeyboardShortcutsOverlay';
import { ReplitAgentPanel } from '@/components/editor/ReplitAgentPanel';
import { ReplitFileExplorer } from '@/components/editor/ReplitFileExplorer';
import { ReplitMonacoEditor } from '@/components/editor/ReplitMonacoEditor';
import { ReplitConsole } from '@/components/editor/ReplitConsole';
import { ReplitGitPanel } from '@/components/editor/ReplitGitPanel';
import { ReplitDatabasePanel } from '@/components/editor/ReplitDatabasePanel';
import { ReplitSecretsPanel } from '@/components/editor/ReplitSecretsPanel';
import { ReplitTerminalPanel } from '@/components/editor/ReplitTerminalPanel';
import { CommandPalette as EditorCommandPalette } from '@/components/editor/CommandPalette';
import { ResponsiveWebPreview } from '@/components/editor/ResponsiveWebPreview';

// Tab configuration
interface Tab {
  id: string;
  label: string;
  icon?: any;
  closable?: boolean;
  filePath?: string;
  fileContent?: string;
  fileId?: string;
}

// File tree node structure
interface FileNode {
  id: string;
  name: string;
  type: 'file' | 'folder';
  path: string;
  content?: string;
  language?: string;
  children?: FileNode[];
}

export default function IDEPage() {
  const params = useParams();
  const [, navigate] = useLocation();
  const { user } = useAuth();
  const { toast } = useToast();
  const queryClient = useQueryClient();
  
  // Project ID from route params
  const projectId = params.projectId as string || params.id as string;
  
  // State management
  const [tabs, setTabs] = useState<Tab[]>([
    { id: 'preview', label: 'Preview', icon: Eye, closable: false }
  ]);
  const [activeTab, setActiveTab] = useState('preview');
  const [files, setFiles] = useState<FileNode[]>([]);
  const [selectedFile, setSelectedFile] = useState<FileNode | null>(null);
  const [isRunning, setIsRunning] = useState(false);
  const [showFileExplorer, setShowFileExplorer] = useState(true);
  const [showCommandPalette, setShowCommandPalette] = useState(false);
  const [showQuickFileSearch, setShowQuickFileSearch] = useState(false);
  const [showKeyboardShortcuts, setShowKeyboardShortcuts] = useState(false);
  const [gitBranch, setGitBranch] = useState('main');
  const [cursorPosition, setCursorPosition] = useState({ line: 1, column: 1 });
  const [activeFileLanguage, setActiveFileLanguage] = useState('TypeScript');
  
  // Auto-save timer
  const autoSaveTimerRef = useRef<NodeJS.Timeout | null>(null);
  
  // Load project data
  const { data: project, isLoading: isLoadingProject } = useQuery<Project>({
    queryKey: ['/api/projects', projectId],
    enabled: !!projectId && !!user,
  });
  
  // Load project files
  const { data: projectFiles = [], isLoading: isLoadingFiles } = useQuery<File[]>({
    queryKey: [`/api/projects/${projectId}/files`],
    enabled: !!projectId && !!user,
  });
  
  // Convert flat files to tree structure
  useEffect(() => {
    if (projectFiles.length > 0) {
      const tree = buildFileTree(projectFiles);
      setFiles(tree);
    }
  }, [projectFiles]);
  
  // Build file tree from flat file list
  const buildFileTree = (flatFiles: File[]): FileNode[] => {
    const root: FileNode[] = [];
    const map = new Map<string, FileNode>();
    
    // Create all nodes
    flatFiles.forEach(file => {
      const node: FileNode = {
        id: file.id,
        name: file.name,
        type: file.path.includes('/') ? 'folder' : 'file',
        path: file.path,
        content: file.content || '',
        language: file.language || 'plaintext',
        children: []
      };
      map.set(file.path, node);
    });
    
    // Build tree structure
    flatFiles.forEach(file => {
      const node = map.get(file.path);
      if (!node) return;
      
      const pathParts = file.path.split('/');
      if (pathParts.length === 1) {
        root.push(node);
      } else {
        const parentPath = pathParts.slice(0, -1).join('/');
        const parent = map.get(parentPath);
        if (parent && parent.children) {
          parent.children.push(node);
        }
      }
    });
    
    return root;
  };
  
  // Handle file selection
  const handleFileSelect = (file: FileNode) => {
    setSelectedFile(file);
    openFileInTab(file);
  };
  
  // Open file in a new tab
  const openFileInTab = (file: FileNode) => {
    const existingTab = tabs.find(t => t.filePath === file.path);
    
    if (existingTab) {
      setActiveTab(existingTab.id);
    } else {
      const newTab: Tab = {
        id: `file:${file.id}`,
        label: file.name,
        icon: FileCode,
        closable: true,
        filePath: file.path,
        fileContent: file.content || '',
        fileId: file.id
      };
      setTabs(prev => [...prev, newTab]);
      setActiveTab(newTab.id);
    }
    
    setActiveFileLanguage(file.language || 'plaintext');
  };
  
  // Close tab
  const closeTab = (tabId: string) => {
    const tab = tabs.find(t => t.id === tabId);
    if (!tab || !tab.closable) return;
    
    const newTabs = tabs.filter(t => t.id !== tabId);
    setTabs(newTabs);
    
    if (activeTab === tabId) {
      setActiveTab(newTabs.length > 0 ? newTabs[0].id : 'preview');
    }
  };
  
  // Add new tab (for tools like console, git, etc.)
  const addTab = (toolId: string) => {
    const existingTab = tabs.find(t => t.id === toolId);
    if (existingTab) {
      setActiveTab(toolId);
      return;
    }
    
    const toolTabs: Record<string, Tab> = {
      console: { id: 'console', label: 'Console', icon: TerminalIcon, closable: true },
      git: { id: 'git', label: 'Git', icon: GitBranch, closable: true },
      database: { id: 'database', label: 'Database', icon: Database, closable: true },
      secrets: { id: 'secrets', label: 'Secrets', icon: Lock, closable: true },
      terminal: { id: 'terminal', label: 'Terminal', icon: TerminalIcon, closable: true },
      search: { id: 'search', label: 'Search', icon: Search, closable: true },
      settings: { id: 'settings', label: 'Settings', icon: Settings, closable: true },
    };
    
    const newTab = toolTabs[toolId];
    if (newTab) {
      setTabs(prev => [...prev, newTab]);
      setActiveTab(newTab.id);
    }
  };
  
  // Handle file content change
  const handleFileContentChange = (content: string) => {
    const activeTabData = tabs.find(t => t.id === activeTab);
    if (!activeTabData || !activeTabData.filePath) return;
    
    // Update tab content
    setTabs(prev => prev.map(t => 
      t.id === activeTab ? { ...t, fileContent: content } : t
    ));
    
    // Clear existing auto-save timer
    if (autoSaveTimerRef.current) {
      clearTimeout(autoSaveTimerRef.current);
    }
    
    // Set new auto-save timer (2 seconds)
    autoSaveTimerRef.current = setTimeout(() => {
      saveFileToBackend(activeTab, content);
    }, 2000);
  };
  
  // Save file to backend
  const saveFileToBackend = async (tabId: string, content: string) => {
    const tab = tabs.find(t => t.id === tabId);
    if (!tab || !tab.filePath || !projectId) return;
    
    try {
      await apiRequest('PUT', `/api/projects/${projectId}/files`, {
        path: tab.filePath,
        content,
        language: activeFileLanguage
      });
      
      // Update file tree
      queryClient.invalidateQueries({ queryKey: [`/api/projects/${projectId}/files`] });
      
      toast({
        title: 'File saved',
        description: `${tab.label} has been saved successfully.`,
      });
    } catch (error) {
      toast({
        title: 'Save failed',
        description: 'Failed to save file to server.',
        variant: 'destructive',
      });
    }
  };
  
  // Manual save (Cmd+S)
  const handleManualSave = () => {
    const activeTabData = tabs.find(t => t.id === activeTab);
    if (activeTabData && activeTabData.fileContent !== undefined) {
      saveFileToBackend(activeTab, activeTabData.fileContent);
    }
  };
  
  // Run/Stop project
  const handleRunStop = () => {
    setIsRunning(prev => !prev);
    toast({
      title: isRunning ? 'Project stopped' : 'Project running',
      description: isRunning ? 'Development server stopped.' : 'Development server started on port 3000.',
    });
  };
  
  // Keyboard shortcuts
  useEffect(() => {
    const handleKeyDown = (e: KeyboardEvent) => {
      const isMac = navigator.platform.toUpperCase().indexOf('MAC') >= 0;
      const modKey = isMac ? e.metaKey : e.ctrlKey;
      
      // Cmd/Ctrl + K - Command Palette
      if (modKey && e.key === 'k') {
        e.preventDefault();
        setShowCommandPalette(true);
      }
      
      // Cmd/Ctrl + P - Quick File Search
      if (modKey && e.key === 'p') {
        e.preventDefault();
        setShowQuickFileSearch(true);
      }
      
      // Cmd/Ctrl + S - Save
      if (modKey && e.key === 's') {
        e.preventDefault();
        handleManualSave();
      }
      
      // Cmd/Ctrl + B - Toggle File Explorer
      if (modKey && e.key === 'b') {
        e.preventDefault();
        setShowFileExplorer(prev => !prev);
      }
      
      // Cmd/Ctrl + W - Close Tab
      if (modKey && e.key === 'w') {
        e.preventDefault();
        closeTab(activeTab);
      }
      
      // Cmd/Ctrl + / - Keyboard Shortcuts
      if (modKey && e.key === '/') {
        e.preventDefault();
        setShowKeyboardShortcuts(true);
      }
      
      // Cmd/Ctrl + Enter - Run/Stop
      if (modKey && e.key === 'Enter') {
        e.preventDefault();
        handleRunStop();
      }
    };
    
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [activeTab, tabs, isRunning]);
  
  // Command execution
  const executeCommand = (commandId: string) => {
    const commands: Record<string, () => void> = {
      'toggle-file-explorer': () => setShowFileExplorer(prev => !prev),
      'quick-file-search': () => setShowQuickFileSearch(true),
      'save-all': () => handleManualSave(),
      'run-project': () => handleRunStop(),
      'new-file': () => toast({ title: 'New file', description: 'Create file from explorer' }),
      'new-folder': () => toast({ title: 'New folder', description: 'Create folder from explorer' }),
      'open-console': () => addTab('console'),
      'open-git': () => addTab('git'),
      'open-terminal': () => addTab('terminal'),
      'open-settings': () => addTab('settings'),
    };
    
    const command = commands[commandId];
    if (command) {
      command();
      setShowCommandPalette(false);
    }
  };
  
  // Render main content based on active tab
  const renderMainContent = () => {
    const activeTabData = tabs.find(t => t.id === activeTab);
    if (!activeTabData) return null;
    
    if (activeTab === 'preview') {
      return <PreviewPanel projectId={projectId} isRunning={isRunning} />;
    }
    
    if (activeTab === 'console') {
      return <ConsolePanel projectId={projectId} />;
    }
    
    if (activeTab === 'git') {
      return <GitPanel projectId={projectId} onBranchChange={setGitBranch} />;
    }
    
    if (activeTab === 'database') {
      return <DatabasePanel projectId={projectId} />;
    }
    
    if (activeTab === 'secrets') {
      return <SecretsPanel projectId={projectId} />;
    }
    
    if (activeTab === 'terminal') {
      return <TerminalPanel projectId={projectId} />;
    }
    
    // File editor
    if (activeTabData.filePath) {
      return (
        <ProfessionalCodeEditor
          fileName={activeTabData.label}
          initialContent={activeTabData.fileContent || ''}
          language={activeFileLanguage}
          onChange={handleFileContentChange}
          onSave={handleManualSave}
          onCursorChange={setCursorPosition}
        />
      );
    }
    
    return null;
  };
  
  // Loading state
  if (isLoadingProject || isLoadingFiles) {
    return <ECodeLoading fullScreen size="lg" text="Loading workspace..." />;
  }
  
  if (!project) {
    return (
      <div className="flex h-screen items-center justify-center">
        <div className="text-center">
          <h2 className="text-2xl font-bold">Project not found</h2>
          <p className="text-muted-foreground mt-2">The project you're looking for doesn't exist.</p>
          <Button onClick={() => navigate('/projects')} className="mt-4">
            Back to Projects
          </Button>
        </div>
      </div>
    );
  }
  
  return (
    <div className="flex flex-col h-screen bg-background">
      {/* Top Navigation Bar */}
      <TopNavBar
        projectName={project.name}
        projectSlug={project.slug || project.id}
        ownerUsername={user?.username || ''}
        isDeployed={project.deployed || false}
        onRun={handleRunStop}
        isRunning={isRunning}
        tabs={tabs}
        activeTab={activeTab}
        onTabChange={setActiveTab}
        onTabClose={closeTab}
        onAddTab={addTab}
        showFileExplorer={showFileExplorer}
        onToggleFileExplorer={() => setShowFileExplorer(prev => !prev)}
      />
      
      {/* Main Layout - 3 Panels */}
      <ResizablePanelGroup direction="horizontal" className="flex-1">
        {/* LEFT PANEL - AI Agent (30%) */}
        <ResizablePanel defaultSize={30} minSize={20} maxSize={40}>
          <div className="h-full flex flex-col border-r">
            <Tabs defaultValue="agent" className="h-full flex flex-col">
              <TabsList className="w-full justify-start rounded-none border-b">
                <TabsTrigger value="agent" className="gap-2">
                  <Brain className="h-4 w-4" />
                  Agent
                </TabsTrigger>
                <TabsTrigger value="actions" className="gap-2">
                  <Zap className="h-4 w-4" />
                  Actions
                </TabsTrigger>
              </TabsList>
              
              <TabsContent value="agent" className="flex-1 mt-0 overflow-hidden">
                <AIAgentPanel 
                  projectId={projectId}
                  onFileCreate={(path, content) => {
                    queryClient.invalidateQueries({ queryKey: [`/api/projects/${projectId}/files`] });
                  }}
                />
              </TabsContent>
              
              <TabsContent value="actions" className="flex-1 mt-0 overflow-hidden">
                <AgentActionsPanel projectId={projectId} />
              </TabsContent>
            </Tabs>
          </div>
        </ResizablePanel>
        
        <ResizableHandle withHandle />
        
        {/* CENTER PANEL - Main Content (52%) */}
        <ResizablePanel defaultSize={52} minSize={30}>
          <div className="h-full flex flex-col">
            {renderMainContent()}
          </div>
        </ResizablePanel>
        
        <ResizableHandle withHandle />
        
        {/* RIGHT PANEL - File Explorer (18%) */}
        {showFileExplorer && (
          <ResizablePanel defaultSize={18} minSize={15} maxSize={30}>
            <FileExplorerPanel
              files={files}
              selectedFile={selectedFile}
              onFileSelect={handleFileSelect}
              onClose={() => setShowFileExplorer(false)}
              projectId={projectId}
            />
          </ResizablePanel>
        )}
      </ResizablePanelGroup>
      
      {/* Status Bar */}
      <StatusBar
        gitBranch={gitBranch}
        isRunning={isRunning}
        cursorPosition={cursorPosition}
        language={activeFileLanguage}
        encoding="UTF-8"
        onShowShortcuts={() => setShowKeyboardShortcuts(true)}
      />
      
      {/* Modals & Overlays */}
      <CommandPalette
        open={showCommandPalette}
        onOpenChange={setShowCommandPalette}
        onExecuteCommand={executeCommand}
      />
      
      <QuickFileSearch
        open={showQuickFileSearch}
        onOpenChange={setShowQuickFileSearch}
        files={files}
        onFileSelect={(file) => {
          handleFileSelect(file);
          setShowQuickFileSearch(false);
        }}
      />
      
      <KeyboardShortcutsOverlay
        open={showKeyboardShortcuts}
        onOpenChange={setShowKeyboardShortcuts}
      />
    </div>
  );
}
