VITE_STRIPE_PUBLIC_KEY = "pk_live_51QPg0B2VSIgdqPLPDbmZ9Sr7cs6mB7sJjvIICcdzKbt88GGB901LRxH6RJtiNp0wMDQt0tm4LOS6zOEvKSP7g7Nv00NZTMdDKH"
