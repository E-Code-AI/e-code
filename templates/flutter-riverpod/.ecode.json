{
  "id": "flutter-riverpod",
  "name": "Flutter + Riverpod",
  "author": "Official",
  "category": "mobile",
  "language": "dart",
  "runtime": "node",
  "ports": [
    8080
  ],
  "install": "npm install",
  "dev": "npm run dev -- --port 8080",
  "build": "npm run build",
  "start": "npm run start -- --port 8080",
  "hidden": [
    "node_modules",
    "dist",
    ".next",
    ".git"
  ],
  "recommendedExtensions": [
    "ecode.cloud-run",
    "ecode.gcs",
    "ecode.secret-manager"
  ],
  "suggestedCloudRun": {
    "region": "us-central1",
    "cpu": "1",
    "memory": "512Mi",
    "minInstances": 0,
    "maxInstances": 5,
    "timeoutSeconds": 300
  },
  "tags": [
    "mobile",
    "flutter",
    "cloud-run",
    "official"
  ],
  "difficulty": "intermediate",
  "previewBucket": "ecode-templates-previews",
  "previewObject": "flutter-riverpod/preview.png"
}
