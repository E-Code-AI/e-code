# =============================================================================
# .replitignore - Exclude from Replit deployments
# =============================================================================

# Large user data directories (1.6GB+)
projects/
uploads/
backups/

# Dependencies (installed at deploy time)
node_modules/
.npm/
.pnpm-store/

# Source maps and type declarations (not needed in prod)
*.map
*.d.ts

# Keep all pre-built dist assets for VM deployment
# We do not ignore dist/index.js or dist/runner.js because the VM runs them directly

# Source code (not needed in prod since we use pre-built dist)
client/
server/
shared/
runner/

# Development test/spec files
test/
*.test.*
*.spec.*

# Git repository
.git/

# Documentation
docs/
*.md

# Logs
*.log
logs/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment
.env*

# TypeScript source cache
tsconfig.tsbuildinfo

# Coverage
coverage/

# Tmp
tmp/
temp/
