# ✅ E-Code Platform Production Environment Variables
# Vérifié: 26 Novembre 2025
# Domain: https://e-code.ai
# Copy this file to .env.production and fill in all values

# ═══════════════════════════════════════════════════════════════
# CORE CONFIGURATION
# ═══════════════════════════════════════════════════════════════
NODE_ENV=production
PORT=5000
APP_URL=https://e-code.ai

# ═══════════════════════════════════════════════════════════════
# DATABASE (PostgreSQL - Neon Serverless)
# ═══════════════════════════════════════════════════════════════
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
PGHOST=your-database-host
PGPORT=5432
PGUSER=your-database-user
PGPASSWORD=your-database-password
PGDATABASE=your-database-name

# ═══════════════════════════════════════════════════════════════
# REDIS CACHE
# ═══════════════════════════════════════════════════════════════
REDIS_URL=redis://user:password@host:6379
REDIS_ENABLED=true

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION & SECURITY
# ═══════════════════════════════════════════════════════════════
SESSION_SECRET=your-very-long-random-session-secret-change-this
JWT_SECRET=your-very-long-random-jwt-secret-change-this
JWT_REFRESH_SECRET=your-jwt-refresh-secret-change-this
ENCRYPTION_KEY=your-32-character-encryption-key-change-this

# OAuth Providers
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-client-secret

# ═══════════════════════════════════════════════════════════════
# AI API KEYS (Multi-Provider Support)
# ═══════════════════════════════════════════════════════════════
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
GEMINI_API_KEY=your-gemini-api-key
XAI_API_KEY=your-xai-api-key
MOONSHOT_API_KEY=your-moonshot-api-key
PERPLEXITY_API_KEY=your-perplexity-api-key

# ═══════════════════════════════════════════════════════════════
# EMAIL SERVICE (SendGrid)
# ═══════════════════════════════════════════════════════════════
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=noreply@e-code.ai

# ═══════════════════════════════════════════════════════════════
# PAYMENT PROCESSING (Stripe)
# ═══════════════════════════════════════════════════════════════
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
VITE_STRIPE_PUBLIC_KEY=your-stripe-publishable-key

# ═══════════════════════════════════════════════════════════════
# STORAGE (Replit Object Storage or S3)
# ═══════════════════════════════════════════════════════════════
# For Replit: Uses built-in Object Storage automatically
# For S3:
S3_BUCKET=your-s3-bucket-name
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-west-2

# ═══════════════════════════════════════════════════════════════
# CDN & STATIC ASSETS
# ═══════════════════════════════════════════════════════════════
CDN_URL=https://cdn.e-code.ai

# ═══════════════════════════════════════════════════════════════
# MONITORING & OBSERVABILITY
# ═══════════════════════════════════════════════════════════════
SENTRY_DSN=your-sentry-dsn
LOG_LEVEL=info
LOG_FORMAT=json

# ═══════════════════════════════════════════════════════════════
# SECURITY - CORS & RATE LIMITING
# ═══════════════════════════════════════════════════════════════
# For Replit deployment, include: dev URL, published URL, custom domain
# Example: ALLOWED_ORIGINS=https://your-repl.replit.dev,https://your-app.replit.app,https://e-code.ai
ALLOWED_ORIGINS=https://e-code.ai,https://www.e-code.ai,https://app.e-code.ai
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# ═══════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════
ENABLE_COLLABORATION=true
ENABLE_AI=true
ENABLE_DEPLOYMENTS=true
ENABLE_BILLING=true
ENABLE_ANALYTICS=true

# AI UX Features (Replit-like experience)
FEATURE_AI_UX_IMPROVE_PROMPT=true
FEATURE_AI_UX_EXTENDED_THINKING=true
FEATURE_AI_UX_HIGH_POWER_MODE=true
FEATURE_AI_UX_PROGRESS_TAB=true
FEATURE_AI_UX_PAUSE_RESUME=true

# ═══════════════════════════════════════════════════════════════
# EXTERNAL SERVICES
# ═══════════════════════════════════════════════════════════════
GITHUB_APP_ID=your-github-app-id
GITHUB_APP_PRIVATE_KEY=your-github-app-private-key

# ═══════════════════════════════════════════════════════════════
# REPLIT DEPLOYMENT CONFIGURATION
# ═══════════════════════════════════════════════════════════════
# These are auto-populated by Replit:
# REPL_ID, REPL_SLUG, REPL_OWNER, REPLIT_DEV_DOMAIN, REPLIT_DOMAINS

# ═══════════════════════════════════════════════════════════════
# MONITORING ENDPOINTS (for Admin UI)
# ═══════════════════════════════════════════════════════════════
# Health:    https://e-code.ai/api/health
# Metrics:   https://e-code.ai/api/metrics
# Detailed:  https://e-code.ai/api/health/detailed
# Liveness:  https://e-code.ai/health/liveness
# Readiness: https://e-code.ai/health/readiness
# Admin:     https://e-code.ai/admin/monitoring
