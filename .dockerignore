# Node modules (will be reinstalled during build)
node_modules/
npm-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml

# Caches (CRITICAL - can be huge)
.cache/
.npm/
.yarn/
**/.cache/
**/node_modules/.cache/

# Go build cache
.cache/go-build/

# Playwright cache (can be 500MB+)
.cache/ms-playwright/

# Git and version control
.git/
.gitignore
.gitattributes

# Environment files (NEVER include secrets)
.env
.env.*
.env.local
.env.*.local
*.local

# Build artifacts that will be regenerated
dist/
builds/
temp/
.cache/
coverage/
.nyc_output/
.parcel-cache/
.next/
out/
build/

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
/tmp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test files (CRITICAL - save significant space)
