# =============================================================================
# .replitignore - Exclude from Replit deployments
# =============================================================================

# Large user data directories (1.6GB+)
projects/
uploads/
backups/

# Dependencies (installed at deploy time)
node_modules/
.npm/
.pnpm-store/

# Source maps and type declarations (not needed in prod)
*.map
*.d.ts

# Server bundles only — rebuilt during deployment build step
# dist/public/ is KEPT (pre-built frontend, static assets, not JS code)
dist/index.js
dist/runner.js

# Development test/spec files
test/
*.test.*
*.spec.*

# Git repository
.git/

# Documentation
docs/
*.md

# Logs
*.log
logs/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Environment
.env*

# TypeScript source cache
tsconfig.tsbuildinfo

# Coverage
coverage/

# Tmp
tmp/
temp/
