# =============================================================================
# E-CODE ENVIRONMENT VARIABLES - Fortune 500 Production Configuration
# =============================================================================

# Application
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_VERSION=1.0.0
NEXT_PUBLIC_APP_URL=https://e-code.app

# =============================================================================
# ANALYTICS & MONITORING
# =============================================================================

# Google Analytics 4
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN=your_mixpanel_token

# Custom Analytics Endpoint
NEXT_PUBLIC_ANALYTICS_ENDPOINT=https://analytics.e-code.app/api/events

# =============================================================================
# ERROR TRACKING
# =============================================================================

# Sentry
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
SENTRY_AUTH_TOKEN=your_sentry_auth_token
SENTRY_ORG=your_org
SENTRY_PROJECT=e-code

# =============================================================================
# LOGGING
# =============================================================================

# Log Level (DEBUG, INFO, WARN, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Log Endpoint
LOG_ENDPOINT=https://logs.e-code.app/api/logs

# CloudWatch / Datadog
DATADOG_API_KEY=your_datadog_api_key
DATADOG_APP_KEY=your_datadog_app_key

# =============================================================================
# SECURITY
# =============================================================================

# Encryption Key (32+ characters)
ENCRYPTION_KEY=your_super_secret_encryption_key_minimum_32_chars

# Session Secret
SESSION_SECRET=your_session_secret_key

# CSRF Token Secret
CSRF_SECRET=your_csrf_secret_key

# =============================================================================
# AUTHENTICATION
# =============================================================================

# JWT
JWT_SECRET=your_jwt_secret_key
JWT_EXPIRATION=7d

# OAuth (if applicable)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# =============================================================================
# DATABASE
# =============================================================================

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/ecode
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=your_redis_password

# =============================================================================
# STORAGE
# =============================================================================

# AWS S3
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=e-code-files

# =============================================================================
# CI/CD
# =============================================================================

# GitHub Actions
GITHUB_TOKEN=your_github_token

# Vercel
VERCEL_TOKEN=your_vercel_token
VERCEL_ORG_ID=your_vercel_org_id
VERCEL_PROJECT_ID=your_vercel_project_id

# Docker Hub
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_token

# =============================================================================
# SECURITY SCANNING
# =============================================================================

# Snyk
SNYK_TOKEN=your_snyk_token

# CodeQL (GitHub)
CODEQL_TOKEN=your_codeql_token

# =============================================================================
# NOTIFICATIONS
# =============================================================================

# Slack
SLACK_WEBHOOK=https://hooks.slack.com/services/xxx/xxx/xxx

# Email (SendGrid)
SENDGRID_API_KEY=your_sendgrid_api_key
EMAIL_FROM=noreply@e-code.app

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Feature Flag Service
FEATURE_FLAGS_ENDPOINT=https://flags.e-code.app/api/flags

# LaunchDarkly (optional)
LAUNCHDARKLY_SDK_KEY=your_launchdarkly_key

# =============================================================================
# PERFORMANCE MONITORING
# =============================================================================

# New Relic (optional)
NEW_RELIC_LICENSE_KEY=your_new_relic_license_key
NEW_RELIC_APP_NAME=E-Code

# =============================================================================
# RATE LIMITING
# =============================================================================

# Rate Limit Config
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# =============================================================================
# CORS
# =============================================================================

# Allowed Origins (comma-separated)
CORS_ORIGINS=https://e-code.app,https://www.e-code.app

# =============================================================================
# DEVELOPMENT ONLY
# =============================================================================

# Bundle Analyzer
ANALYZE=false

# Debug Mode
DEBUG=false
