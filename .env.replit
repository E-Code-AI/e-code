# Replit Configuration for E-Code
# Environment variables for Replit deployment

# Replit detection
REPLIT=true
REPL_SLUG=e-code
REPL_OWNER=your-username

# Automatic URLs (set by Replit)
# REPL_ID will be auto-populated
# Full URL: https://${REPL_SLUG}.${REPL_OWNER}.repl.co

# Database (Replit Database)
DATABASE_URL=$REPLIT_DB_URL

# API Configuration
NODE_ENV=production
PORT=3000

# WebSocket (use Replit URL)
# Will be: wss://e-code.your-username.repl.co

# Frontend Build
VITE_API_BASE_URL=https://${REPL_SLUG}.${REPL_OWNER}.repl.co
VITE_WS_URL=wss://${REPL_SLUG}.${REPL_OWNER}.repl.co

# Mobile App Configuration
EXPO_PUBLIC_API_URL=https://${REPL_SLUG}.${REPL_OWNER}.repl.co
EXPO_PUBLIC_WS_URL=wss://${REPL_SLUG}.${REPL_OWNER}.repl.co

# Security
SESSION_SECRET=your-secret-key-here-change-in-production
JWT_SECRET=your-jwt-secret-here-change-in-production

# CORS Origins
CORS_ORIGINS=https://${REPL_SLUG}.${REPL_OWNER}.repl.co,https://*.repl.co

# Features
ENABLE_COLLABORATION=true
ENABLE_AI_AGENT=true
ENABLE_DEPLOYMENT=true

# Logging
LOG_LEVEL=info
