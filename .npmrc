# Production optimization settings for npm
# Reduce installation size and improve build times

# Don't save package-lock.json (reduces deployment size)
package-lock=false

# Skip optional dependencies to reduce size
optional=false

# Don't install dev dependencies in production
production=false

# Reduce audit verbosity
audit-level=moderate

# Use legacy peer deps to avoid conflicts
legacy-peer-deps=true

# Disable fund messages
fund=false

# Disable update notifier
update-notifier=false

# Reduce network retries for faster fails
fetch-retries=2
fetch-retry-mintimeout=10000
fetch-retry-maxtimeout=60000

# Progress indicator
progress=true

# Strict SSL
strict-ssl=true

# Cache location (helps with Replit caching)
cache=/tmp/npm-cache
