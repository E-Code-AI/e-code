LOG_LEVEL = "warn"
ENABLE_BILLING = "true"
ENABLE_COLLABORATION = "true"
ENABLE_AI = "true"
ENABLE_DEPLOYMENTS = "true"
ENABLE_ANALYTICS = "true"
PORT = "80"
DB_POOL_SIZE = "25"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

