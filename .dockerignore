# ===========================================
# CRITICAL: Files/folders excluded from deployment
# This file reduces deployment image from 4GB+ to under 2GB
# ===========================================

# Node modules - reinstalled during build with --omit=dev
node_modules

# User-generated project data (2.8GB+)
projects

# Development-only directories
sdk
vscode-extension
cli
github-copilot-extension
mobile
android
ios
containers
desktop
kubernetes
deploy
e-code
migrations
reports
scripts
services
storage
introspected

# Git and version control
.git
.gitignore
.gitattributes

# Environment files (NEVER deploy secrets)
.env
.env.*
.env.local
*.local

# Build artifacts (regenerated during build)
dist
builds
temp
coverage
.nyc_output
.parcel-cache
.next
out
build

# Caches (CRITICAL - can be 500MB+)
.cache
.cache/
.npm
.yarn
**/.cache
**/node_modules/.cache
.cache/go-build
.cache/ms-playwright
.cache/typescript

# Logs and temporary files
logs
*.log
*.tmp
*.temp
/tmp
npm-debug.log*
yarn-error.log*
yarn-debug.log*
pnpm-debug.log*
lerna-debug.log*

# IDE and editor files
.vscode
.idea
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test files
__tests__
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
test
tests
playwright
.playwright
playwright-report
test-results
e2e
cypress

# Documentation
*.md
docs
documentation

# Development configuration
tsconfig.check.json
tsconfig.full.json
.eslintrc*
.prettierrc*
prettier.config.*
eslint.config.*
.editorconfig
.browserslistrc
babel.config.*
jest.config.*
vitest.config.*
playwright.config.*
vite.config.ts.timestamp*

# Source maps
**/*.map
*.js.map
*.d.ts.map

# CI/CD
.github
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml
.circleci
docker-compose*

# Replit specific
.replit
replit.nix
.config
.upm
.breakpoints
.local
.pythonlibs
.nix

# Large assets
attached_assets
generated-icon.png

# Lock files (keep package-lock.json)
yarn.lock
pnpm-lock.yaml

# Database files
*.db
*.sqlite
*.sqlite3
*.sql

# Secrets and credentials
*.pem
*.key
*.crt
*.p12
*.pfx
secrets
credentials

# Backup files
*.bak
*.backup
*.old

# OS generated files
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Test data
**/fixtures
**/testdata
**/__snapshots__
**/__mocks__

# Analysis output
*.lcov

# Session files
*.txt
*.jar
cookies.*
*_snapshot.png

# Shell scripts
*.sh
