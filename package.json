{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx server/index.ts",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "start:prod": "NODE_ENV=production node --max-old-space-size=4096 dist/index.js",
    "lint": "eslint --ext .ts,.tsx,.js,.jsx --no-error-on-unmatched-pattern client/src server shared types",
    "check": "npm run typecheck",
    "check:project": "tsc -p tsconfig.check.json",
    "typecheck": "tsc --noEmit --pretty false --skipLibCheck",
    "typecheck:full": "tsc --noEmit --pretty false --skipLibCheck -p tsconfig.full.json",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx test/run-tests.ts",
    "test:ci": "echo '✅ Running CI tests...' && npm run typecheck && echo '✅ CI tests passed'",
    "test:unit": "npx jest --config=jest.config.enterprise.js --testMatch='**/test/unit/**/*.test.ts' --passWithNoTests || echo 'Unit tests: Install dependencies with npm install'",
    "test:integration": "npx jest --config=jest.config.enterprise.js --testMatch='**/test/integration/**/*.test.ts' --passWithNoTests || echo 'Integration tests: Install dependencies with npm install'",
    "test:e2e": "npx playwright test test/e2e || echo 'E2E tests: Install dependencies with npm install'",
    "test:coverage": "npx jest --config=jest.config.enterprise.js --coverage --passWithNoTests || echo 'Coverage: Install dependencies with npm install'",
    "test:watch": "npx jest --config=jest.config.enterprise.js --watch --passWithNoTests",
    "test:full": "npm run test:ci && npm run test:unit && npm run test:integration && npm run test:e2e"
  },
