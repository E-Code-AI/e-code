# E-Code Platform — Staging Environment Variables
# Copy to .env.staging and fill in. Staging mirrors production but writes to
# a separate database, talks to test AI keys, and is publicly reachable for
# pre-release smoke + load testing.

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
NODE_ENV=staging
DEPLOYMENT_MODE=replit-deploy
APP_URL=https://staging.e-code.ai

# =============================================================================
# DATABASE — separate cluster, never points at prod
# =============================================================================
POSTGRES_PASSWORD=staging_secure_password_here
DATABASE_URL=postgresql://ecode:${POSTGRES_PASSWORD}@postgres-staging:5432/ecode_staging

# =============================================================================
# REDIS — separate instance to prevent staging from poisoning prod cache
# =============================================================================
REDIS_ENABLED=true
REDIS_URL=redis://redis-staging:6379

# =============================================================================
# AI PROVIDERS — test keys with low rate limits
# =============================================================================
OPENAI_API_KEY=sk-staging-test-...
ANTHROPIC_API_KEY=sk-ant-staging-test-...

# =============================================================================
# DEPLOYMENT QUOTAS (looser than prod — staging exercises edge cases)
# =============================================================================
DEPLOYMENT_QUOTA_FREE=3
DEPLOYMENT_QUOTA_CORE=10
DEPLOYMENT_IDLE_SLEEP_MS=600000

# =============================================================================
# OBSERVABILITY — separate Prometheus/OTEL endpoints
# =============================================================================
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector-staging:4318/v1/traces
PROMETHEUS_PORT=9464
SENTRY_DSN=https://staging-sentry-dsn@sentry.io/staging
SENTRY_ENVIRONMENT=staging

# =============================================================================
# EMAIL — sandbox sender so staging never spams real users
# =============================================================================
SENDGRID_API_KEY=SG.staging-sandbox.xxx
EMAIL_FROM=staging-noreply@e-code.ai
EMAIL_SANDBOX=true

# =============================================================================
# LOAD TEST + SMOKE
# =============================================================================
# Allow synthetic users from k6 / Playwright without rate-limiting them out
RATE_LIMIT_BYPASS_INTERNAL=true
PLAYWRIGHT_PANEL_E2E=true
