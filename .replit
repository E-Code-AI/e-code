modules = ["web", "postgresql-16", "nodejs-20"]
run = "npm run dev"
hidden = [".config", ".git", "generated-icon.png", "node_modules", "dist"]

[nix]
channel = "stable-24_05"
packages = ["glibcLocales", "jq", "libxcrypt", "imagemagick", "python3", "gcc", "gnumake"]

[deployment]
deploymentTarget = "vm"
run = ["sh", "-c", ". /etc/profile 2>/dev/null; . ~/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; RUNNER_PORT=8081 node dist/runner.js & RUNNER_BASE_URL=http://localhost:8081 NODE_OPTIONS='--max-old-space-size=4096' node dist/index.js"]
build = ["sh", "-c", ". /etc/profile 2>/dev/null; . ~/.nix-profile/etc/profile.d/nix.sh 2>/dev/null; npm install --include=dev && npm run build"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Runner"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
agentRequireRestartOnSave = false
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_OPTIONS='--max-old-space-size=4096' npm run dev"
waitForPort = 5000

[[workflows.workflow]]
name = "Start Runner"
author = "agent"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "RUNNER_PORT=8081 DOCKER_ENABLED=false RUNNER_JWT_SECRET=${RUNNER_JWT_SECRET:-dev-runner-secret-change-me} npx tsx runner/index.ts"

[agent]
integrations = [
  "javascript_slack:1.0.0",
  "javascript_openai:1.0.0",
  "javascript_anthropic:1.0.0",
  "javascript_xai:1.0.0",
  "javascript_gemini:1.0.0",
  "perplexity_v0:1.0.0",
  "javascript_sendgrid:1.0.0",
  "javascript_stripe:1.0.0",
  "javascript_websocket:1.0.0",
  "javascript_openai_ai_integrations:1.0.0",
]

[objectStorage]
defaultBucketID = "replit-objstore-2566672f-a4a2-4a4f-94f0-4e6c88fa4e9b"

[userenv]

