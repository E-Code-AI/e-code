# Node modules (will be reinstalled during build)
node_modules/
npm-debug.log*
yarn-error.log*
yarn.lock
pnpm-lock.yaml

# Caches (CRITICAL - can be huge)
.cache/
.npm/
.yarn/
**/.cache/
**/node_modules/.cache/

# Go build cache
.cache/go-build/

# Playwright cache (can be 500MB+)
.cache/ms-playwright/

# Git and version control
.git/
.gitignore
.gitattributes

# Environment files (NEVER include secrets)
.env
.env.*
.env.local
.env.*.local
*.local

# Build artifacts that will be regenerated
dist/
builds/
temp/
.cache/
coverage/
.nyc_output/
.parcel-cache/
.next/
out/
build/

# Logs and temporary files
logs/
*.log
*.tmp
*.temp
/tmp/

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Test files (CRITICAL - save significant space)
__tests__/
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
test/
tests/
playwright/
.playwright/
playwright-report/
test-results/
e2e/
cypress/

# Documentation (not needed in runtime)
*.md
docs/
documentation/
PRODUCTION_READINESS.md
audit-report.md
CHANGELOG*
LICENSE*
✅_*.md
STRIPE_SECURITY.md

# Development configuration
tsconfig.check.json
tsconfig.full.json
.eslintrc*
.prettierrc*
prettier.config.*
eslint.config.*
.editorconfig
.browserslistrc
babel.config.*
jest.config.*
vitest.config.*
playwright.config.*
vite.config.ts.timestamp*

# Development-only directories (CRITICAL - save >3GB)
dokploy/
sdk/
vscode-extension/
cli/
github-copilot-extension/
mobile/
android/
ios/
containers/
desktop/
kubernetes/
deploy/
e-code/
migrations/
projects/
reports/
scripts/
services/
storage/

# Source maps (remove to save space)
**/*.map
dist/public/*.map
*.js.map
*.d.ts.map

# CI/CD and Docker (not needed inside container)
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile
azure-pipelines.yml
.circleci/
Dockerfile
docker-compose*
.dockerignore

# Replit specific
.replit
replit.nix
.config/
.upm/
.breakpoints/
.cache/

# Large development image assets (keep client/public for production)
attached_assets/
generated-icon.png
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.ico
*.svg

# Exclude all markdown files except README in client
**/*.md
!client/README.md

# Shell scripts not needed in production
*.sh
!start.js

# SQL files
*.sql

# Config files for build tools not needed at runtime
vite.config.optimized.ts
vite.config.production.ts
vitest.config.ts
ecosystem.config.js
docker-compose*.yml
nginx.conf

# Session and temp files
*.txt
*.jar
cookies.*
*_snapshot.png

# Database files (use remote database)
*.db
*.sqlite
*.sqlite3
*.sql

# Generated files (will be built during deployment)
server/public/

# Java and containers
*.jar
containers/seccomp.json

# Development dependencies metadata
.npm/
.yarn/
.pnpm-store/
.pnpm-debug.log

# TypeScript build info
*.tsbuildinfo
tsconfig.tsbuildinfo

# Storybook and component documentation
storybook/
.storybook/
chromatic/

# Benchmarks and performance testing
benchmarks/
perf/

# Secrets and credentials (should NEVER be included)
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials/

# Backup files
*.bak
*.backup
*.old

# OS generated files
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.ini

# Package manager caches
.npm/
.yarn-integrity
.yarn/cache
.yarn/unplugged
.yarn/install-state.gz
