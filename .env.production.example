# E-Code Platform - Production Environment Variables
# Copy this file to .env.production and fill in the values

# =============================================================================
# DEPLOYMENT MODE
# =============================================================================
# Active production target
DEPLOYMENT_MODE=replit-deploy

# Legacy / archived deployment features
# Keep false unless you are explicitly reviving archived Kubernetes paths.
KUBERNETES_ENABLED=false

# =============================================================================
# DATABASE
# =============================================================================
POSTGRES_PASSWORD=your_secure_password_here
DATABASE_URL=postgresql://ecode:${POSTGRES_PASSWORD}@postgres:5432/ecode

# =============================================================================
# REDIS (Cache & WebSocket PubSub)
# =============================================================================
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379

# =============================================================================
# AI PROVIDERS (Required)
# =============================================================================
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=...
XAI_API_KEY=...
MOONSHOT_API_KEY=...

# =============================================================================
# EXTERNAL SERVICES (Required for production launch unless feature hard-disabled)
# =============================================================================
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
SENDGRID_API_KEY=SG....
SENTRY_DSN=https://...@sentry.io/...
VITE_SENTRY_DSN=https://...@sentry.io/...
SENTRY_AUTH_TOKEN=sntrys_...
SLACK_WEBHOOK_URL=https://hooks.slack.com/...

# =============================================================================
# SECURITY
# =============================================================================
SESSION_SECRET=your_32_char_random_string_here
JWT_SECRET=your_32_char_random_string_here
JWT_REFRESH_SECRET=your_32_char_random_string_here
ENCRYPTION_KEY=your_32_char_random_string_here
TRUST_PROXY_HOPS=1

# [REQUIRED] Comma-separated list of allowed CORS origins.
# In production, requests from unlisted origins are rejected with 403.
# Format: ALLOWED_ORIGINS=https://domain1.com,https://domain2.com
# On Replit, REPLIT_DOMAINS is used as fallback ONLY when ALLOWED_ORIGINS is unset.
ALLOWED_ORIGINS=https://e-code.ai

# =============================================================================
# APPLICATION
# =============================================================================
NODE_ENV=production
PORT=5000
APP_URL=https://e-code.ai
FRONTEND_URL=https://e-code.ai
LOG_LEVEL=info
TRUST_PROXY_HOPS=1

# =============================================================================
# OBJECT STORAGE / BACKUPS
# =============================================================================
STORAGE_BACKEND=s3
S3_REGION=us-east-1
S3_BUCKET=your-app-bucket
S3_ACCESS_KEY_ID=your-access-key
S3_SECRET_ACCESS_KEY=your-secret-key
BACKUP_CRON=0 3 * * *
ENABLE_BACKUPS=true

# =============================================================================
# RUNNER / SANDBOX
# =============================================================================
RUNNER_BASE_URL=https://runner.internal
RUNNER_JWT_SECRET=shared-runner-secret

# =============================================================================
# OPTIONAL AI / MONITORING FLAGS
# =============================================================================
SENTRY_TRACES_SAMPLE_RATE=0.1
FEATURE_AI_UX_EXTENDED_THINKING=true
FEATURE_AI_UX_HIGH_POWER_MODE=true
FEATURE_AI_UX_IMPROVE_PROMPT=true

# =============================================================================
# SSH GATEWAY (Inbound SSH access to user workspaces)
# =============================================================================
# Set ENABLED=true to start the in-process SSH gateway (server/ssh/gateway.ts).
# When enabled, the gateway listens on SSH_GATEWAY_PORT and authenticates
# inbound connections against the ssh_keys table populated via
# /api/ssh-keys. Successful auth spawns an interactive shell (via node-pty)
# rooted at SSH_GATEWAY_PROJECT_PATH.
#
# These same vars are surfaced to the frontend through /api/ssh-keys/config
# and gate the visibility of the "Launch VS Code / Cursor" deep-link buttons.
SSH_GATEWAY_ENABLED=true
SSH_GATEWAY_HOST=ssh.e-code.ai
SSH_GATEWAY_PORT=2222
SSH_GATEWAY_USER=runner
SSH_GATEWAY_PROJECT_PATH=/home/runner
# Stable host key — base64-encoded OpenSSH private key
# (the file produced by ssh-keygen, beginning with
# "-----BEGIN OPENSSH PRIVATE KEY-----"). PKCS#8 PEM is NOT supported by ssh2.
# If unset an ephemeral ed25519 key is generated on each boot, and clients
# will see fingerprint-changed warnings on every reconnect.
# Generate with:
#   ssh-keygen -t ed25519 -f /tmp/host -N "" && base64 -w0 /tmp/host
SSH_GATEWAY_HOST_KEY=

# =============================================================================
# DOCKER EXECUTION (For user code sandboxing)
# =============================================================================
EXECUTION_MODE=docker
DOCKER_HOST=tcp://docker:2376
DOCKER_TLS_VERIFY=1
DOCKER_CERT_PATH=/certs/client
DOCKER_NETWORK=ecode-network
